# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# 웹사이트가 Claude API 를 호출할 때 쓰는 키. 이름을 ANTHROPIC_API_KEY 로 바꾸지 말 것.
# (클라우드 세션의 Claude Code 가 ANTHROPIC_API_KEY 를 자기 인증에 가져다 쓸 수 있어 일부러 다른 이름을 쓴다)
LEO_ANTHROPIC_API_KEY=

# 대화와 리포트에 쓰는 모델. 미설정 시 claude-opus-5.
LEO_CLAUDE_MODEL=claude-opus-5

# 1 이면 Claude API 를 호출하지 않고 결정적인 가짜 응답을 돌려준다. 테스트와 UI 작업에 사용.
CLAUDE_MOCK=0

# Prisma SQLite
DATABASE_URL="file:./dev.db"
# 무료 배포는 libsql://...turso.io 와 해당 DB 전용 토큰을 사용한다.
# 로컬 개발 .env는 그대로 두고 배포 환경에 별도로 설정한다.
# TURSO_AUTH_TOKEN=

# 세션 서명용 비밀값. 32자 이상 임의 문자열.
AUTH_SECRET=

# 앱 공개 URL (로컬 개발 기본값)
APP_URL=http://localhost:3000

# 시드 사용자 2명의 비밀번호. 미설정 시 leo-pass-1234.
# 개발·테스트 전용. 운영에서는 npm run users 로 개별 계정을 발급한다.
SEED_USER_PASSWORD=leo-pass-1234

# 명시적으로 1일 때만 공개 가입 허용. 기본은 차단.
LEO_ALLOW_SIGNUP=0
# 정식 초대 운영에서는 1. 운영자 명령으로 발급하지 않은 기존 계정도 차단한다.
LEO_INVITE_ONLY=0
