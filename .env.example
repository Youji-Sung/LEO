# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다.

# 웹사이트가 Claude API 를 호출할 때 쓰는 키. 이름을 ANTHROPIC_API_KEY 로 바꾸지 말 것.
# (클라우드 세션의 Claude Code 가 ANTHROPIC_API_KEY 를 자기 인증에 가져다 쓸 수 있어 일부러 다른 이름을 쓴다)
LEO_ANTHROPIC_API_KEY=

# 대화와 리포트에 쓰는 모델. 미설정 시 claude-opus-5.
LEO_CLAUDE_MODEL=claude-opus-5

# 1 이면 Claude API 를 호출하지 않고 결정적인 가짜 응답을 돌려준다. 테스트와 UI 작업에 사용.
CLAUDE_MOCK=0

# Prisma SQLite
DATABASE_URL="file:./dev.db"

# 세션 서명용 비밀값. 32자 이상 임의 문자열.
AUTH_SECRET=

# 앱 공개 URL (로컬 개발 기본값)
APP_URL=http://localhost:3000
