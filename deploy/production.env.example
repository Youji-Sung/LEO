# Copy to /etc/leo/production.env on the server (chmod 600). Never commit real values.
NODE_ENV=production
LEO_PRODUCTION=1
LEO_INVITE_ONLY=1
LEO_ALLOW_SIGNUP=0
CLAUDE_MOCK=0
LEO_REQUIRE_ACCESS=1
APP_URL=https://CHANGE_ME
CF_ACCESS_ISSUER=https://CHANGE_ME.cloudflareaccess.com
CF_ACCESS_AUD=CHANGE_ME
DATABASE_URL=file:/data/leo.db
AUTH_SECRET=CHANGE_ME
LEO_HEALTH_TOKEN=CHANGE_ME
LEO_ANTHROPIC_API_KEY=CHANGE_ME
LEO_CLAUDE_MODEL=claude-opus-5
LEO_API_MONTHLY_USD=200
# Initial abuse guard; this is not a separate charge or a daily allocation promise.
LEO_API_USER_DAILY_USD=20
LEO_API_CONCURRENCY=5
# Set to 1 only after checking the provider's own budget/limit and current tariffs.
LEO_BILLING_LIMIT_CONFIRMED=0
BACKUP_DIR=/backups
BACKUP_KEEP=7
