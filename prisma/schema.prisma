// 스키마는 Postgres 호환으로 유지한다 (SQLite 전용 타입 금지, JSON 은 문자열로 저장).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  status        String         @default("active")
  provisioned   Boolean        @default(false)
  credentialVersion Int        @default(0)
  role          String         @default("member")
  sessions      Session[]
  conversations Conversation[]
  usageRecords  UsageRecord[]
  portfolios    Portfolio[]
  settings      UserSettings?
  invitations   AccountInvitation[]
  learningItems LearningItem[]
}

model AccountInvitation {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  createdAt DateTime @default(now())
}

model ApiReservation {
  id           String   @id
  userId       String
  feature      String
  amountMicros Int
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status, userId])
}

model LoginAttempt {
  key       String   @id
  count     Int
  expiresAt DateTime
}

model RuntimeControl {
  key String @id
  value String
}

model ReportJob {
  conversationId String @id
  userId         String
  status         String
  error          String?
  leaseToken     String?
  updatedAt      DateTime @updatedAt
}

model WorkLease {
  key       String   @id
  token     String
  expiresAt DateTime
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// kind: chat | call. theme: free | interview | daily | work | business | portfolio
model Conversation {
  id           String     @id @default(cuid())
  userId       String
  kind         String
  theme        String
  title        String?
  durationSec  Int?
  hintsEnabled Boolean    @default(false)
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  portfolioId  String?
  openingLine  String?
  learningTargets String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio    Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  messages     Message[]
  report       Report?
  learningItems LearningItem[]

  @@index([userId, updatedAt])
}

// role: user | assistant. hint: 교정 힌트(사용자 발화에 대한 한 줄), assistant 메시지에 붙는다.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  hint           String?
  speech         String?
  index          Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, index])
}

model LearningItem {
  id String @id @default(cuid())
  userId String
  sourceConversationId String
  sourceKey String
  phrase String
  original String
  explanation String
  example String
  stage Int @default(0)
  reviewCount Int @default(0)
  dueAt DateTime @default(now())
  lastAnswer String @default("")
  lastOutcome String?
  lastUsedAt DateTime?
  lastUseConversationId String?
  lastUseText String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation Conversation @relation(fields: [sourceConversationId], references: [id], onDelete: Cascade)
  @@unique([userId, sourceKey])
  @@index([userId, dueAt])
}

model Report {
  id             String       @id @default(cuid())
  conversationId String       @unique
  json           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// feature: chat | call | report | portfolio
model UsageRecord {
  id               String   @id @default(cuid())
  userId           String
  feature          String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float
  latencyMs        Int
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Portfolio {
  id            String         @id @default(cuid())
  userId        String
  title         String
  content       String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
}

model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  hintsDefault       Boolean @default(false)
  ttsVoice           String?
  speechTerms        String  @default("")
  defaultCallMinutes Int     @default(10)
  // system | light | dark (docs/design/SYSTEM.md 1.3)
  theme              String  @default("system")
  // basic | study | stage | console (docs/design/directions/README.md)
  direction          String  @default("basic")
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
